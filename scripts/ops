#!/usr/bin/env node
// ops — tiny CLI for Claude sessions to log their work into the ops console.
//
// Each task is filed under the workspace (product) it is about — chosen per task
// with --ws, so one session can log Chesslang and ProLearnr work side by side.
// A session opens a task, tracks stages on the task's Journey
// (plan → prepare → execute → verify → done), adds progress notes, and on
// completion closes the task and files a KB doc tagged with the same workspace.
// The "main KB" is simply every workspace's KB docs together (Docs → All workspaces).
//
// Config:
//   OPS_URL    base URL (default https://ops.shortcastle.com)
//   OPS_TOKEN  bearer token override; otherwise read from ~/.config/ops/token
// The token is never printed.

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const BASE = (process.env.OPS_URL || 'https://ops.shortcastle.com').replace(/\/+$/, '');
const TOKEN_FILE = path.join(os.homedir(), '.config', 'ops', 'token');

const WORKSPACES = [
   'chesslang',
   'chesslang-one',
   'prolearnr',
   'bytechess',
   'chessmethod',
   'trainerdb',
   'shortcastle',
   'mrzerocode',
];
const PHASES = ['plan', 'prepare', 'execute', 'verify', 'done'];
const STATUSES = [
   'to-do',
   'in-progress',
   'technical-review',
   'blocked',
   'paused',
   'done',
   'canceled',
];

const USAGE = `ops — log Claude session work into the ops console

Usage:
  ops task new "<title>" --ws <slug> [--desc <text>]     create a task (in-progress); prints OPS-n
  ops stage <OPS-n> <phase> "<title>"                     add a Journey step; prints the step id
  ops stage-done <step-id>                                mark a Journey step done
  ops note <OPS-n> "<text>"                               append a progress note
  ops status <OPS-n> <status>                             set the task status
  ops done <OPS-n> --kb "<title>" --kb-body <file|->      close the task + file a KB doc, linked to it

Interns (tracked people, no console login, nothing is ever sent to them; owner/admin):
  ops intern add "<name>" [--ws <slug>]                   add an intern (default workspace trainerdb)
  ops intern list                                         interns, open task, performance + overall
  ops intern show <name>                                  one intern's tasks, events (IST) and numbers
  ops intern assign <OPS-n> <name> [--code CLN-01] [--priority P0]   assign (one open task per intern)
  ops intern sent <OPS-n> [--file <name>]                 the task message/PDF was sent to him
  ops intern start <OPS-n>                                he reported starting the task
  ops eod <OPS-n> --body <file|->                         his EOD summary (also filed as a KB doc)
  ops review <OPS-n> --rating <1-5> --outcome <continue|changes|approve> [--notes <text>]
                                                          review it; approve closes the task
  Every intern command takes --at "YYYY-MM-DD HH:MM" (IST) to backfill when it happened; default now.

  phases:     ${PHASES.join(' | ')}
  statuses:   ${STATUSES.join(' | ')}
  workspaces: ${WORKSPACES.join(' | ')}  (--ws is required: the product the task is about)

Env: OPS_URL (default https://ops.shortcastle.com), OPS_TOKEN (else ~/.config/ops/token)`;

function die(msg, code = 1) {
   process.stderr.write(`ops: ${msg}\n`);
   process.exit(code);
}

function token() {
   if (process.env.OPS_TOKEN) return process.env.OPS_TOKEN.trim();
   try {
      const t = fs.readFileSync(TOKEN_FILE, 'utf8').trim();
      if (t) return t;
   } catch {}
   die(`no token — put the ops bearer token in ${TOKEN_FILE} (chmod 600) or set OPS_TOKEN`);
}

async function api(method, route, body) {
   let res;
   try {
      res = await fetch(`${BASE}/api/ops${route}`, {
         method,
         headers: { 'Authorization': `Bearer ${token()}`, 'Content-Type': 'application/json' },
         body: body === undefined ? undefined : JSON.stringify(body),
         // Don't follow redirects: an unknown route is bounced to /login (HTML).
         redirect: 'manual',
      });
   } catch (e) {
      die(`cannot reach ${BASE} (${e.cause?.code || e.message})`);
   }
   // Anything that isn't JSON (a login redirect, an HTML error page) means the
   // route isn't there — e.g. the server hasn't been deployed with this feature.
   if (!(res.headers.get('content-type') || '').includes('application/json'))
      die(
         `${method} ${route} → ${res.status} unexpected non-JSON response — is this feature deployed on ${BASE}?`
      );
   const data = await res.json().catch(() => null);
   if (!res.ok) die(`${method} ${route} → ${res.status} ${data?.error || res.statusText}`);
   if (!data || typeof data !== 'object') die(`${method} ${route} → empty response`);
   return data;
}

// Split argv into positionals and --flags (each flag takes one value).
function parse(args) {
   const pos = [];
   const flags = {};
   for (let i = 0; i < args.length; i++) {
      const a = args[i];
      if (a.startsWith('--')) {
         const v = args[i + 1];
         if (v === undefined) die(`${a} needs a value`);
         flags[a.slice(2)] = v;
         i++;
      } else pos.push(a);
   }
   return { pos, flags };
}

function need(v, what) {
   if (!v) die(`missing ${what}\n\n${USAGE}`);
   return v;
}

function oneOf(v, list, what) {
   if (!list.includes(v)) die(`unknown ${what} "${v}" — use one of: ${list.join(', ')}`);
   return v;
}

function readBody(src) {
   if (src === '-') return fs.readFileSync(0, 'utf8');
   try {
      return fs.readFileSync(src, 'utf8');
   } catch {
      die(`cannot read file: ${src}`);
   }
}

const session = () => path.basename(process.cwd());

// "--at 2026-10-06 15:40" is IST; sent as-is (the server parses IST).
function atFlag(v) {
   if (v === undefined) return undefined;
   if (!/^\d{4}-\d{2}-\d{2}[ T]\d{1,2}:\d{2}$/.test(v.trim()))
      die(`--at must be "YYYY-MM-DD HH:MM" (IST), got "${v}"`);
   return v.trim();
}

const ist = (iso) =>
   iso
      ? new Date(iso).toLocaleString('en-GB', {
           timeZone: 'Asia/Kolkata',
           day: 'numeric',
           month: 'short',
           hour: '2-digit',
           minute: '2-digit',
           hour12: false,
        })
      : '–';

function perfLine(p) {
   const pct = p.eod_on_time_rate != null ? `${Math.round(p.eod_on_time_rate * 100)}%` : '–';
   const trend = p.rating_trend.length ? ` [${p.rating_trend.slice(-8).join(' ')}]` : '';
   return `${p.tasks_done} done (P0 ${p.p0_done}, P1 ${p.p1_done}) · rating ${p.avg_rating ?? '–'}/5${trend} · ${p.avg_task_days ?? '–'} days/task · ${p.avg_review_rounds ?? '–'} rounds · EODs on time ${pct} · sent → first EOD ${p.avg_hours_to_first_eod ?? '–'} h · review turnaround ${p.avg_turnaround_hours ?? '–'} h`;
}

async function main() {
   const [cmd, ...rest] = process.argv.slice(2);
   const { pos, flags } = parse(rest);

   switch (cmd) {
      case 'task': {
         if (pos[0] !== 'new') die(`usage: ops task new "<title>" --ws <slug> [--desc <text>]`);
         const title = need(pos[1], 'task title');
         const workspace = oneOf(
            need(flags.ws, `--ws <slug> (${WORKSPACES.join(', ')})`),
            WORKSPACES,
            'workspace'
         );
         const { issue } = await api('POST', '/issues', {
            title,
            description: flags.desc || '',
            workspace,
            status_id: 'in-progress',
         });
         console.log(issue.identifier || issue.id);
         return;
      }
      case 'stage': {
         const id = need(pos[0], 'task id (OPS-n)');
         const phase = oneOf(need(pos[1], 'phase'), PHASES, 'phase');
         const title = need(pos[2], 'step title');
         const { step } = await api('POST', `/issues/${encodeURIComponent(id)}/steps`, {
            phase,
            title,
            status: 'doing',
         });
         console.log(step.id);
         return;
      }
      case 'stage-done': {
         const stepId = need(pos[0], 'step id');
         await api('PATCH', `/steps/${encodeURIComponent(stepId)}`, {
            status: 'done',
            by: session(),
         });
         console.log('ok');
         return;
      }
      case 'note': {
         const id = need(pos[0], 'task id (OPS-n)');
         const note = need(pos[1], 'note text');
         await api('POST', `/issues/${encodeURIComponent(id)}`, { note, session: session() });
         console.log('ok');
         return;
      }
      case 'status': {
         const id = need(pos[0], 'task id (OPS-n)');
         const status = oneOf(need(pos[1], 'status'), STATUSES, 'status');
         await api('PATCH', `/issues/${encodeURIComponent(id)}`, { status_id: status });
         console.log('ok');
         return;
      }
      case 'done': {
         const id = need(pos[0], 'task id (OPS-n)');
         const kbTitle = need(flags.kb, '--kb "<title>"');
         const body = readBody(need(flags['kb-body'], '--kb-body <file|->')).trim();
         if (!body) die('KB body is empty');
         const { issue } = await api('GET', `/issues/${encodeURIComponent(id)}`);
         const workspace = issue?.workspace;
         if (!workspace)
            die(`${id} has no workspace — set one in the console before filing its KB doc`);
         await api('PATCH', `/issues/${encodeURIComponent(id)}`, { status_id: 'done' });
         const { doc } = await api('POST', '/docs', {
            title: kbTitle,
            body,
            category: 'KB',
            workspace,
         });
         await api('POST', `/docs/${doc.id}/links`, { issue: issue?.identifier || id });
         console.log(`${issue?.identifier || id} done · KB doc ${doc.id} (${workspace})`);
         return;
      }
      case 'intern': {
         const sub = pos[0];
         const at = atFlag(flags.at);
         if (sub === 'add') {
            const name = need(pos[1], 'intern name');
            const ws = flags.ws ? oneOf(flags.ws, WORKSPACES, 'workspace') : undefined;
            const { intern } = await api('POST', '/interns', { name, workspace: ws });
            console.log(`${intern.name} added (${intern.workspace})`);
         } else if (sub === 'list') {
            const { interns, overall } = await api('GET', '/interns');
            if (!interns.length) console.log('no interns');
            for (const n of interns) {
               const cur = n.current
                  ? `${n.current.identifier}${n.current.backlog_code ? ' ' + n.current.backlog_code : ''} — ${n.current.title}`
                  : 'no open task';
               console.log(`${n.name}${n.active ? '' : ' (inactive)'} · ${cur}`);
               console.log(`  ${perfLine(n.perf)}`);
            }
            console.log(
               `\nOverall (${overall.interns_active} active): ${overall.tasks_open} open · ${perfLine(overall)}`
            );
         } else if (sub === 'show') {
            const name = need(pos[1], 'intern name');
            const { intern, tasks } = await api('GET', `/interns/${encodeURIComponent(name)}`);
            console.log(`${intern.name} · ${intern.workspace}\n  ${perfLine(intern.perf)}`);
            for (const t of tasks) {
               const st = t.stats;
               console.log(
                  `\n${t.identifier}${t.backlog_code ? ' ' + t.backlog_code : ''}${t.priority ? ' ' + t.priority : ''} — ${t.title} [${t.closed_at ? 'closed' : 'open'}]`
               );
               console.log(
                  `  assigned ${ist(t.assigned_at)} · sent ${ist(st.sent_at)}${st.started_at ? ' · started ' + ist(st.started_at) : ''}${t.closed_at ? ' · approved ' + ist(t.closed_at) : ''}`
               );
               console.log(
                  `  ${st.calendar_days} days (${st.working_days} working) · EODs ${st.eod_on_time}/${st.eod_expected} on time · sent → first EOD ${st.hours_to_first_eod ?? '–'} h · ${st.reviews} reviews (${st.changes} changes) · review turnaround ${st.avg_turnaround_hours ?? '–'} h`
               );
               for (const e of t.events) {
                  const when = ist(e.at);
                  if (e.kind === 'sent')
                     console.log(`  ${when} sent${e.file ? ': ' + e.file : ''}`);
                  else if (e.kind === 'start') console.log(`  ${when} started`);
                  else if (e.kind === 'eod')
                     console.log(`  ${when} eod: ${e.body.split('\n')[0].slice(0, 70)}`);
                  else
                     console.log(
                        `  ${when} review ${e.rating}/5 ${e.outcome}${e.body ? ' — ' + e.body.split('\n')[0].slice(0, 60) : ''}`
                     );
               }
            }
         } else if (sub === 'assign') {
            const id = need(pos[1], 'task id (OPS-n)');
            const name = need(pos[2], 'intern name');
            const { task } = await api('POST', `/issues/${encodeURIComponent(id)}/intern`, {
               intern: name,
               code: flags.code || '',
               priority: flags.priority || '',
               at,
            });
            console.log(`${task.identifier} assigned to ${name} at ${ist(task.assigned_at)} IST`);
         } else if (sub === 'sent' || sub === 'pdf' || sub === 'start') {
            const id = need(pos[1], 'task id (OPS-n)');
            const kind = sub === 'start' ? 'start' : 'sent';
            const { event } = await api('POST', `/issues/${encodeURIComponent(id)}/intern/events`, {
               kind,
               file: flags.file || '',
               at,
            });
            console.log(`ok · ${kind} at ${ist(event.at)} IST`);
         } else {
            die('usage: ops intern add|list|show|assign|sent|start … (see ops --help)');
         }
         return;
      }
      case 'eod': {
         const id = need(pos[0], 'task id (OPS-n)');
         const body = readBody(need(flags.body, '--body <file|->')).trim();
         if (!body) die('EOD summary is empty');
         const { event } = await api('POST', `/issues/${encodeURIComponent(id)}/intern/events`, {
            kind: 'eod',
            body,
            at: atFlag(flags.at),
            by: session(),
         });
         console.log(`ok · ${ist(event.at)} IST · KB doc ${event.doc_id}`);
         return;
      }
      case 'review': {
         const id = need(pos[0], 'task id (OPS-n)');
         const rating = Number(need(flags.rating, '--rating <1-5>'));
         const outcome = oneOf(
            need(flags.outcome, '--outcome <continue|changes|approve>'),
            ['continue', 'changes', 'approve'],
            'outcome'
         );
         const { event } = await api('POST', `/issues/${encodeURIComponent(id)}/intern/events`, {
            kind: 'review',
            rating,
            outcome,
            body: flags.notes || '',
            at: atFlag(flags.at),
            by: session(),
         });
         console.log(
            `ok · ${ist(event.at)} IST${outcome === 'approve' ? ` · ${id} approved and closed` : ''}`
         );
         return;
      }
      case undefined:
      case 'help':
      case '-h':
      case '--help':
         console.log(USAGE);
         return;
      default:
         die(`unknown command "${cmd}"\n\n${USAGE}`);
   }
}

main();
