#!/usr/bin/env node
// ops — tiny CLI for Claude sessions to log their work into the ops console.
//
// Each task is filed under the workspace (product) it is about — chosen per task
// with --ws, so one session can log Chesslang and ProLearnr work side by side.
// A session opens a task, tracks stages on the task's Journey
// (plan → prepare → execute → verify → done), adds progress notes, and on
// completion closes the task and files a KB doc tagged with the same workspace.
// The "main KB" is simply every workspace's KB docs together (Docs → All workspaces).
//
// Config:
//   OPS_URL    base URL (default https://ops.shortcastle.com)
//   OPS_TOKEN  bearer token override; otherwise read from ~/.config/ops/token
// The token is never printed.

const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');

const BASE = (process.env.OPS_URL || 'https://ops.shortcastle.com').replace(/\/+$/, '');
const TOKEN_FILE = path.join(os.homedir(), '.config', 'ops', 'token');

const WORKSPACES = [
   'chesslang',
   'chesslang-one',
   'prolearnr',
   'bytechess',
   'chessmethod',
   'trainerdb',
   'shortcastle',
   'mrzerocode',
];
const PHASES = ['plan', 'prepare', 'execute', 'verify', 'done'];
const STATUSES = [
   'to-do',
   'in-progress',
   'technical-review',
   'blocked',
   'paused',
   'done',
   'canceled',
];

const USAGE = `ops — log Claude session work into the ops console

Usage:
  ops task new "<title>" --ws <slug> [--desc <text>] [--trio] [--owner <session>] [--by <nissi|arun|jarvis>]
               [--parent <OPS-n>]                        --parent: this task is one part of a bigger task
                                                          create a task (in-progress); prints its id
  ops stage <OPS-n> <phase> "<title>"                     add a Journey step; prints the step id
  ops stage-done <step-id>                                mark a Journey step done
  ops note <OPS-n> "<text>"                               append a progress note
  ops status <OPS-n> <status> [--waiting <nissi|arun>]    set the status; --waiting only with blocked,
                                                          any other status clears it
  ops list [--trio] [--ws <slug>] [--status open|all|<status>] [--owner <session>] [--by <who>]
           [--waiting <nissi|arun>] [--since YYYY-MM-DD] [--parent <OPS-n>] [--roots] [--limit N] [--json]
                                                          tasks, newest update first (default: open, 50)
  ops show <OPS-n> [--json]                               one task: fields, Journey, last notes, KB docs
  ops trio <OPS-n> [--off]                                mark (or unmark) a task as a trio task
  ops assign <OPS-n> --owner <session>                    set the session that owns a task
  ops parent <OPS-n> <PARENT-n> | ops parent <OPS-n> --off  put a task under a parent (or take it out)
  ops done <OPS-n> --kb "<title>" --kb-body <file|->      close the task + file its task report (a Report
                                                          doc in staging), linked to it
  ops kb list --ws <slug|all> [--staging|--production|--pending|--all] [--by <author>] [--since YYYY-MM-DD] [--json]
                                                          docs, newest first. Production = promoted by Nissi;
                                                          staging = everything else (--pending: in review or
                                                          changes requested). --ws all = the main KB
  ops kb show <doc-id> [--json]                           one doc: layer, author, linked tasks, full body
  ops files <OPS-n> [--json]                              files attached to a task and to its linked docs
                                                          (intern submissions included): id, name, type, size, when
  ops file get <file-id> [--out <path>]                   download one file (default: its own name in the current
                                                          folder; never overwrites)

Interns (tracked people, no console login; owner/admin):
  ops intern add "<name>" [--ws <slug>]                   add an intern (default workspace trainerdb)
  ops intern list                                         interns, open task, performance + overall
  ops intern show <name>                                  one intern's tasks, events (IST) and numbers
  ops intern assign <OPS-n> <name> [--code CLN-01] [--priority P0]   assign (any number of open tasks)
  ops intern sent <OPS-n> [--file <name>]                 the task message/PDF was sent to him
  ops intern start <OPS-n>                                he reported starting the task
  ops eod <OPS-n> --body <file|->                         his EOD summary (also filed as a KB doc)
  ops review <OPS-n> --rating <1-5> --outcome <continue|changes|approve> [--notes <text>]
                                                          review it; approve closes the task
  ops review <OPS-n> --fix [--event <id>] [--rating <1-5>] [--notes <text>]
                                                          correct a review's rating/notes (latest review unless
                                                          --event); works on closed tasks, keeps the original
  ops lark <name> "<text>" [--task <OPS-n>]               post to the intern's Lark group via its bot
                                                          (--task: note it there; replies go to that task)
  ops lark read <name> [--task <OPS-n>] [--limit N]       what people wrote in his group (IST)
  ops lark chats                                          groups the reader bot has heard from
  ops lark bind <name> <oc_chat_id> | --off               link a group to the intern
  Every intern command takes --at "YYYY-MM-DD HH:MM" (IST) to backfill when it happened; default now.

  phases:     ${PHASES.join(' | ')}
  statuses:   ${STATUSES.join(' | ')}
  workspaces: ${WORKSPACES.join(' | ')}  (--ws is required: the product the task is about)

Env: OPS_URL (default https://ops.shortcastle.com), OPS_TOKEN (else ~/.config/ops/token)`;

function die(msg, code = 1) {
   process.stderr.write(`ops: ${msg}\n`);
   process.exit(code);
}

function token() {
   if (process.env.OPS_TOKEN) return process.env.OPS_TOKEN.trim();
   try {
      const t = fs.readFileSync(TOKEN_FILE, 'utf8').trim();
      if (t) return t;
   } catch {}
   die(`no token — put the ops bearer token in ${TOKEN_FILE} (chmod 600) or set OPS_TOKEN`);
}

async function api(method, route, body) {
   let res;
   try {
      res = await fetch(`${BASE}/api/ops${route}`, {
         method,
         headers: { 'Authorization': `Bearer ${token()}`, 'Content-Type': 'application/json' },
         body: body === undefined ? undefined : JSON.stringify(body),
         // Don't follow redirects: an unknown route is bounced to /login (HTML).
         redirect: 'manual',
      });
   } catch (e) {
      die(`cannot reach ${BASE} (${e.cause?.code || e.message})`);
   }
   // Anything that isn't JSON (a login redirect, an HTML error page) means the
   // route isn't there — e.g. the server hasn't been deployed with this feature.
   if (!(res.headers.get('content-type') || '').includes('application/json'))
      die(
         `${method} ${route} → ${res.status} unexpected non-JSON response — is this feature deployed on ${BASE}?`
      );
   const data = await res.json().catch(() => null);
   if (!res.ok) die(`${method} ${route} → ${res.status} ${data?.error || res.statusText}`);
   if (!data || typeof data !== 'object') die(`${method} ${route} → empty response`);
   return data;
}

// Split argv into positionals and --flags (each flag takes one value).
// Flags that take no value.
const BOOL_FLAGS = new Set([
   'fix',
   'trio',
   'off',
   'json',
   'roots',
   'pending',
   'approved',
   'all',
   'staging',
   'production',
]);
const REQUESTERS = ['nissi', 'arun', 'jarvis'];
const WAITERS = ['nissi', 'arun'];

function parse(args) {
   const pos = [];
   const flags = {};
   for (let i = 0; i < args.length; i++) {
      const a = args[i];
      if (BOOL_FLAGS.has(a.slice(2))) {
         flags[a.slice(2)] = true;
      } else if (a.startsWith('--')) {
         const v = args[i + 1];
         if (v === undefined) die(`${a} needs a value`);
         flags[a.slice(2)] = v;
         i++;
      } else pos.push(a);
   }
   return { pos, flags };
}

function need(v, what) {
   if (!v) die(`missing ${what}\n\n${USAGE}`);
   return v;
}

function oneOf(v, list, what) {
   if (!list.includes(v)) die(`unknown ${what} "${v}" — use one of: ${list.join(', ')}`);
   return v;
}

function readBody(src) {
   if (src === '-') return fs.readFileSync(0, 'utf8');
   try {
      return fs.readFileSync(src, 'utf8');
   } catch {
      die(`cannot read file: ${src}`);
   }
}

const session = () => path.basename(process.cwd());

// "--at 2026-10-06 15:40" is IST; sent as-is (the server parses IST).
function atFlag(v) {
   if (v === undefined) return undefined;
   if (!/^\d{4}-\d{2}-\d{2}[ T]\d{1,2}:\d{2}$/.test(v.trim()))
      die(`--at must be "YYYY-MM-DD HH:MM" (IST), got "${v}"`);
   return v.trim();
}

const ist = (iso) =>
   iso
      ? new Date(iso).toLocaleString('en-GB', {
           timeZone: 'Asia/Kolkata',
           day: 'numeric',
           month: 'short',
           hour: '2-digit',
           minute: '2-digit',
           hour12: false,
        })
      : '–';

// One line per task for `ops list`: ID · status · ws · owner · by · [TRIO] · title · updated (IST).
function taskLine(i) {
   const status = i.waiting_on ? `${i.status_id}(${i.waiting_on})` : i.status_id;
   return [
      i.identifier,
      status,
      i.workspace || '–',
      i.owner_session || '–',
      i.requested_by || '–',
      ...(i.trio ? ['[TRIO]'] : []),
      ...(i.parent_identifier ? [`↳ ${i.parent_identifier}`] : []),
      ...(i.child_total ? [`[${i.child_done}/${i.child_total}]`] : []),
      i.title,
      ist(i.updated_at),
   ].join(' · ');
}

// Progress-log lines look like "- [2026-10-08 14:05 · author · session] text";
// lines that don't start a note continue the previous one.
function parseNotes(progress) {
   const notes = [];
   for (const line of progress.split('\n')) {
      const m = line.match(/^- \[(\d{4}-\d{2}-\d{2} \d{2}:\d{2})((?: · [^\]]*)?)\] ?(.*)$/);
      if (m) {
         const parts = m[2]
            .split(' · ')
            .map((x) => x.trim())
            .filter(Boolean);
         notes.push({ at: m[1], session: parts.at(-1) || '', text: m[3] });
      } else if (notes.length && line.trim()) notes[notes.length - 1].text += '\n' + line;
   }
   return notes;
}

const stepMark = (s) => (s === 'done' ? 'x' : s === 'doing' ? '>' : s === 'skipped' ? '-' : ' ');

function perfLine(p) {
   const pct = p.eod_on_time_rate != null ? `${Math.round(p.eod_on_time_rate * 100)}%` : '–';
   const trend = p.rating_trend.length ? ` [${p.rating_trend.slice(-8).join(' ')}]` : '';
   return `${p.tasks_done} done (P0 ${p.p0_done}, P1 ${p.p1_done}) · rating ${p.avg_rating ?? '–'}/5${trend} · ${p.avg_task_days ?? '–'} days/task · ${p.avg_review_rounds ?? '–'} rounds · EODs on time ${pct} · sent → first EOD ${p.avg_hours_to_first_eod ?? '–'} h · review turnaround ${p.avg_turnaround_hours ?? '–'} h`;
}

async function main() {
   const [cmd, ...rest] = process.argv.slice(2);
   const { pos, flags } = parse(rest);

   switch (cmd) {
      case 'task': {
         if (pos[0] !== 'new') die(`usage: ops task new "<title>" --ws <slug> [--desc <text>]`);
         const title = need(pos[1], 'task title');
         const workspace = oneOf(
            need(flags.ws, `--ws <slug> (${WORKSPACES.join(', ')})`),
            WORKSPACES,
            'workspace'
         );
         const body = { title, description: flags.desc || '', workspace, status_id: 'in-progress' };
         if (flags.trio) body.trio = true;
         if (flags.owner) body.owner_session = String(flags.owner);
         if (flags.by)
            body.requested_by = oneOf(String(flags.by).toLowerCase(), REQUESTERS, '--by');
         if (flags.parent) body.parent = String(flags.parent);
         const { issue } = await api('POST', '/issues', body);
         console.log(issue.identifier || issue.id);
         return;
      }
      case 'list': {
         const qs = new URLSearchParams();
         const status = flags.status ? String(flags.status) : 'open';
         if (status !== 'open' && status !== 'all') oneOf(status, STATUSES, 'status');
         if (status !== 'all') qs.set('status', status);
         if (flags.trio) qs.set('trio', '1');
         if (flags.ws) qs.set('ws', oneOf(String(flags.ws), WORKSPACES, 'workspace'));
         if (flags.owner) qs.set('owner', String(flags.owner));
         if (flags.by) qs.set('by', oneOf(String(flags.by).toLowerCase(), REQUESTERS, '--by'));
         if (flags.waiting)
            qs.set('waiting', oneOf(String(flags.waiting).toLowerCase(), WAITERS, '--waiting'));
         if (flags.since) {
            if (!/^\d{4}-\d{2}-\d{2}$/.test(String(flags.since)))
               die(`--since must be YYYY-MM-DD, got "${flags.since}"`);
            qs.set('since', String(flags.since));
         }
         if (flags.parent) qs.set('parent', String(flags.parent));
         if (flags.roots) qs.set('roots', '1');
         if (flags.limit) {
            const n = Number(flags.limit);
            if (!Number.isInteger(n) || n < 1) die('--limit must be a positive number');
            qs.set('limit', String(n));
         }
         const { issues } = await api('GET', `/issues?${qs}`);
         if (flags.json) {
            console.log(JSON.stringify(issues, null, 2));
            return;
         }
         if (!issues.length) console.log('no tasks');
         for (const i of issues) console.log(taskLine(i));
         return;
      }
      case 'show': {
         const id = need(pos[0], 'task id (OPS-n)');
         const ref = encodeURIComponent(id);
         const [{ issue, steps, children }, { docs }] = await Promise.all([
            api('GET', `/issues/${ref}`),
            api('GET', `/issues/${ref}/links`),
         ]);
         const notes = parseNotes(issue.progress || '').slice(-10);
         if (flags.json) {
            const { progress: _progress, ...rest } = issue;
            console.log(JSON.stringify({ ...rest, steps, notes, docs, children }, null, 2));
            return;
         }
         const alias = issue.legacy_identifier ? ` (was ${issue.legacy_identifier})` : '';
         console.log(`${issue.identifier}${alias}${issue.trio ? ' [TRIO]' : ''} — ${issue.title}`);
         console.log(
            `  status ${issue.status_id}${issue.waiting_on ? ` (waiting on ${issue.waiting_on})` : ''} · ws ${issue.workspace || '–'} · owner ${issue.owner_session || '–'} · by ${issue.requested_by || '–'}`
         );
         console.log(`  created ${ist(issue.created_at)} · updated ${ist(issue.updated_at)} IST`);
         if (issue.parent_identifier) console.log(`  part of ${issue.parent_identifier}`);
         if (children?.length) {
            const done = children.filter((c) => ['done', 'canceled'].includes(c.status_id)).length;
            console.log(`\nSub-tasks (${done}/${children.length} done):`);
            for (const c of children)
               console.log(
                  `  ${c.identifier} · ${c.status_id} · ${c.owner_session || '–'} · ${c.title}`
               );
         }
         if (issue.description?.trim()) console.log(`\n${issue.description.trim()}`);
         if (steps?.length) {
            console.log('\nJourney:');
            for (const st of steps)
               console.log(`  [${stepMark(st.status)}] ${st.phase.padEnd(7)} ${st.title}`);
         }
         if (notes.length) {
            console.log('\nLast notes:');
            for (const n of notes)
               console.log(
                  `  ${n.at}${n.session ? ' · ' + n.session : ''}  ${n.text.replace(/\n/g, '\n    ')}`
               );
         }
         if (docs?.length) {
            console.log('\nKB docs:');
            for (const d of docs) console.log(`  ${d.title} (${d.category})`);
         }
         return;
      }
      case 'trio': {
         const id = need(pos[0], 'task id (OPS-n)');
         const { issue } = await api('PATCH', `/issues/${encodeURIComponent(id)}`, {
            trio: !flags.off,
         });
         console.log(
            `${issue.identifier} ${issue.trio ? 'is now a trio task' : 'is no longer a trio task'}`
         );
         return;
      }
      case 'parent': {
         const id = need(pos[0], 'task id (OPS-n)');
         const parent = flags.off ? null : need(pos[1], 'parent task id (or --off)');
         const { issue } = await api('PATCH', `/issues/${encodeURIComponent(id)}`, { parent });
         console.log(
            issue.parent_identifier
               ? `${issue.identifier} is now part of ${issue.parent_identifier}`
               : `${issue.identifier} has no parent`
         );
         return;
      }
      case 'assign': {
         const id = need(pos[0], 'task id (OPS-n)');
         const owner = need(flags.owner, '--owner <session>');
         const { issue } = await api('PATCH', `/issues/${encodeURIComponent(id)}`, {
            owner_session: String(owner),
         });
         console.log(`${issue.identifier} owner: ${issue.owner_session}`);
         return;
      }
      case 'stage': {
         const id = need(pos[0], 'task id (OPS-n)');
         const phase = oneOf(need(pos[1], 'phase'), PHASES, 'phase');
         const title = need(pos[2], 'step title');
         const { step } = await api('POST', `/issues/${encodeURIComponent(id)}/steps`, {
            phase,
            title,
            status: 'doing',
         });
         console.log(step.id);
         return;
      }
      case 'stage-done': {
         const stepId = need(pos[0], 'step id');
         await api('PATCH', `/steps/${encodeURIComponent(stepId)}`, {
            status: 'done',
            by: session(),
         });
         console.log('ok');
         return;
      }
      case 'note': {
         const id = need(pos[0], 'task id (OPS-n)');
         const note = need(pos[1], 'note text');
         await api('POST', `/issues/${encodeURIComponent(id)}`, { note, session: session() });
         console.log('ok');
         return;
      }
      case 'status': {
         const id = need(pos[0], 'task id (OPS-n)');
         const status = oneOf(need(pos[1], 'status'), STATUSES, 'status');
         const body = { status_id: status };
         if (flags.waiting) {
            if (status !== 'blocked') die('--waiting only goes with the blocked status');
            body.waiting_on = oneOf(String(flags.waiting).toLowerCase(), WAITERS, '--waiting');
         }
         await api('PATCH', `/issues/${encodeURIComponent(id)}`, body);
         console.log('ok');
         return;
      }
      case 'done': {
         const id = need(pos[0], 'task id (OPS-n)');
         const kbTitle = need(flags.kb, '--kb "<title>"');
         const body = readBody(need(flags['kb-body'], '--kb-body <file|->')).trim();
         if (!body) die('KB body is empty');
         const { issue } = await api('GET', `/issues/${encodeURIComponent(id)}`);
         const workspace = issue?.workspace;
         if (!workspace)
            die(`${id} has no workspace — set one in the console before filing its KB doc`);
         await api('PATCH', `/issues/${encodeURIComponent(id)}`, { status_id: 'done' });
         const { doc } = await api('POST', '/docs', {
            title: kbTitle,
            body,
            category: 'Report',
            workspace,
         });
         await api('POST', `/docs/${doc.id}/links`, { issue: issue?.identifier || id });
         console.log(`${issue?.identifier || id} done · KB doc ${doc.id} (${workspace})`);
         return;
      }
      case 'intern': {
         const sub = pos[0];
         const at = atFlag(flags.at);
         if (sub === 'add') {
            const name = need(pos[1], 'intern name');
            const ws = flags.ws ? oneOf(flags.ws, WORKSPACES, 'workspace') : undefined;
            const { intern } = await api('POST', '/interns', { name, workspace: ws });
            console.log(`${intern.name} added (${intern.workspace})`);
         } else if (sub === 'list') {
            const { interns, overall } = await api('GET', '/interns');
            if (!interns.length) console.log('no interns');
            for (const n of interns) {
               const open = n.open || (n.current ? [n.current] : []);
               const cur = open.length
                  ? open
                       .map(
                          (t) =>
                             `${t.identifier}${t.backlog_code ? ' ' + t.backlog_code : ''} — ${t.title}`
                       )
                       .join(' | ')
                  : 'no open tasks';
               console.log(`${n.name}${n.active ? '' : ' (inactive)'} · ${cur}`);
               console.log(`  ${perfLine(n.perf)}`);
            }
            console.log(
               `\nOverall (${overall.interns_active} active): ${overall.tasks_open} open · ${perfLine(overall)}`
            );
         } else if (sub === 'show') {
            const name = need(pos[1], 'intern name');
            const { intern, tasks } = await api('GET', `/interns/${encodeURIComponent(name)}`);
            console.log(`${intern.name} · ${intern.workspace}\n  ${perfLine(intern.perf)}`);
            for (const t of tasks) {
               const st = t.stats;
               console.log(
                  `\n${t.identifier}${t.backlog_code ? ' ' + t.backlog_code : ''}${t.priority ? ' ' + t.priority : ''} — ${t.title} [${t.closed_at ? 'closed' : 'open'}]`
               );
               console.log(
                  `  assigned ${ist(t.assigned_at)} · sent ${ist(st.sent_at)}${st.started_at ? ' · started ' + ist(st.started_at) : ''}${t.closed_at ? ' · approved ' + ist(t.closed_at) : ''}`
               );
               console.log(
                  `  ${st.calendar_days} days (${st.working_days} working) · EODs ${st.eod_on_time}/${st.eod_expected} on time · sent → first EOD ${st.hours_to_first_eod ?? '–'} h · ${st.reviews} reviews (${st.changes} changes) · review turnaround ${st.avg_turnaround_hours ?? '–'} h`
               );
               for (const e of t.events) {
                  const when = ist(e.at);
                  if (e.kind === 'sent')
                     console.log(`  ${when} sent${e.file ? ': ' + e.file : ''}`);
                  else if (e.kind === 'start') console.log(`  ${when} started`);
                  else if (e.kind === 'eod')
                     console.log(`  ${when} eod: ${e.body.split('\n')[0].slice(0, 70)}`);
                  else
                     console.log(
                        `  ${when} review ${e.rating}/5 ${e.outcome}${e.body ? ' — ' + e.body.split('\n')[0].slice(0, 60) : ''}`
                     );
               }
            }
         } else if (sub === 'assign') {
            const id = need(pos[1], 'task id (OPS-n)');
            const name = need(pos[2], 'intern name');
            const { task } = await api('POST', `/issues/${encodeURIComponent(id)}/intern`, {
               intern: name,
               code: flags.code || '',
               priority: flags.priority || '',
               at,
            });
            console.log(`${task.identifier} assigned to ${name} at ${ist(task.assigned_at)} IST`);
         } else if (sub === 'sent' || sub === 'pdf' || sub === 'start') {
            const id = need(pos[1], 'task id (OPS-n)');
            const kind = sub === 'start' ? 'start' : 'sent';
            const { event } = await api('POST', `/issues/${encodeURIComponent(id)}/intern/events`, {
               kind,
               file: flags.file || '',
               at,
            });
            console.log(`ok · ${kind} at ${ist(event.at)} IST`);
         } else {
            die('usage: ops intern add|list|show|assign|sent|start … (see ops --help)');
         }
         return;
      }
      case 'kb': {
         const sub = pos[0];
         const stageLabel = (st) =>
            st === 'approved'
               ? 'production'
               : st === 'review'
                 ? 'staging · in review'
                 : st === 'changes'
                   ? 'staging · changes requested'
                   : 'staging';
         const author = (d) =>
            d.author_intern_name ? `${d.author_intern_name} (intern)` : d.created_by || '–';
         if (sub === 'list') {
            const wsArg = need(flags.ws, '--ws <slug|all>');
            const ws = wsArg === 'all' ? 'all' : oneOf(wsArg, WORKSPACES, 'workspace');
            const modes = ['staging', 'production', 'pending', 'approved', 'all'].filter(
               (m) => flags[m]
            );
            if (modes.length > 1) die('use only one of --staging, --production, --pending, --all');
            const mode = modes[0] === 'approved' ? 'production' : modes[0] || 'all';
            if (flags.since && !/^\d{4}-\d{2}-\d{2}$/.test(String(flags.since)))
               die(`--since must be YYYY-MM-DD, got "${flags.since}"`);
            const by = flags.by ? String(flags.by).toLowerCase() : '';
            const { docs } = await api('GET', '/docs');
            const rows = docs
               .filter((d) => ws === 'all' || d.workspace === ws)
               .filter((d) =>
                  mode === 'pending'
                     ? d.review_stage === 'review' || d.review_stage === 'changes'
                     : mode === 'production'
                       ? d.review_stage === 'approved'
                       : mode === 'staging'
                         ? d.review_stage !== 'approved'
                         : true
               )
               .filter((d) => !by || author(d).toLowerCase().includes(by))
               .filter(
                  (d) =>
                     !flags.since ||
                     new Date(d.created_at) >= new Date(`${flags.since}T00:00:00+05:30`)
               )
               .sort((a, b) => (a.created_at < b.created_at ? 1 : -1))
               .map((d) => ({
                  id: d.id,
                  title: d.title,
                  workspace: d.workspace,
                  draft_of: d.draft_of || null,
                  category: d.category,
                  audience: d.category === 'KB' ? d.kb_audience || 'support' : null,
                  status: stageLabel(d.review_stage),
                  author: author(d),
                  intern_visible: !!d.intern_visible,
                  created_at: d.created_at,
                  updated_at: d.updated_at,
               }));
            if (flags.json) {
               console.log(JSON.stringify(rows, null, 2));
               return;
            }
            if (!rows.length) console.log('no docs');
            for (const d of rows)
               console.log(
                  `${d.id} · ${d.status}${d.draft_of ? ' (edit of a production doc)' : ''} · ${ws === 'all' ? (d.workspace || '–') + ' · ' : ''}${d.category}${d.audience === 'marketing' ? ' (marketing)' : ''} · ${d.author} · ${ist(d.created_at)} · ${d.title}`
               );
            return;
         }
         if (sub === 'show') {
            const id = need(pos[1], 'doc id (from ops kb list)');
            const { doc } = await api('GET', `/docs/${encodeURIComponent(id)}`);
            const { issues } = await api('GET', `/docs/${encodeURIComponent(id)}/links`);
            const tasks = (issues || []).map((i) => i.identifier).filter(Boolean);
            if (flags.json) {
               console.log(
                  JSON.stringify(
                     { ...doc, status: stageLabel(doc.review_stage), linked_tasks: tasks },
                     null,
                     2
                  )
               );
               return;
            }
            console.log(doc.title);
            console.log(
               `  ${doc.workspace || '–'} · ${doc.category} · ${stageLabel(doc.review_stage)} · by ${author(doc)}${doc.intern_visible ? ' · visible to interns' : ''}`
            );
            console.log(`  created ${ist(doc.created_at)} · updated ${ist(doc.updated_at)} IST`);
            console.log(`  linked tasks: ${tasks.length ? tasks.join(', ') : '–'}`);
            console.log(`\n${doc.body}`);
            return;
         }
         die('usage: ops kb list --ws <slug> … | ops kb show <doc-id> (see ops --help)');
      }
      case 'lark': {
         if (pos[0] === 'read') {
            const name = need(pos[1], 'intern name');
            const qs = new URLSearchParams();
            if (flags.task) qs.set('task', String(flags.task));
            if (flags.limit) qs.set('limit', String(flags.limit));
            const r = await api('GET', `/interns/${encodeURIComponent(name)}/lark?${qs}`);
            if (flags.json) {
               console.log(JSON.stringify(r.messages, null, 2));
               return;
            }
            if (!r.chat_bound)
               console.log(`(no Lark group bound to ${r.intern} yet — see: ops lark chats)`);
            if (!r.messages.length) console.log('no messages');
            for (const m of r.messages)
               console.log(
                  `${ist(m.sent_at)} · ${m.sender_name || 'someone'}${m.identifier ? ' · ' + m.identifier : ''}: ${m.text}`
               );
            return;
         }
         if (pos[0] === 'chats') {
            const { chats } = await api('GET', '/lark/chats');
            if (!chats.length) console.log('no messages received from any Lark group yet');
            for (const c of chats)
               console.log(
                  `${c.chat_id} · ${c.chat_name || '(no name)'} · ${c.intern ? 'bound to ' + c.intern : 'not bound'} · ${c.messages} msgs · last ${ist(c.last_at)}`
               );
            return;
         }
         if (pos[0] === 'bind') {
            const name = need(pos[1], 'intern name');
            const chat = flags.off ? '' : need(pos[2], 'chat id (oc_…, from ops lark chats)');
            const r = await api('POST', `/interns/${encodeURIComponent(name)}/lark-chat`, {
               chat_id: chat,
            });
            console.log(chat ? `${r.intern} ← ${chat}` : `${r.intern}: Lark group unbound`);
            return;
         }
         const name = need(pos[0], 'intern name');
         const text = need(pos[1], 'message text');
         const r = await api('POST', `/interns/${encodeURIComponent(name)}/lark`, {
            text,
            task: flags.task ? String(flags.task) : undefined,
         });
         if (flags.task)
            await api('POST', `/issues/${encodeURIComponent(String(flags.task))}`, {
               note: `Posted to ${r.intern}'s Lark group: ${text}`,
               session: session(),
            });
         console.log(
            `posted to ${r.intern}'s Lark group${flags.task ? ` · noted on ${flags.task}` : ''}`
         );
         return;
      }
      case 'files': {
         const id = need(pos[0], 'task id (OPS-n)');
         const ref = encodeURIComponent(id);
         const [{ attachments }, { docs }] = await Promise.all([
            api('GET', `/attachments?issue=${ref}`),
            api('GET', `/issues/${ref}/links`),
         ]);
         const rows = attachments.map((a) => ({ ...a, from: a.intern_id ? 'task (intern)' : 'task' }));
         for (const d of docs || []) {
            const r = await api('GET', `/attachments?doc=${encodeURIComponent(d.id)}`);
            for (const a of r.attachments) rows.push({ ...a, from: `doc ${d.id} · ${d.title}` });
         }
         if (flags.json) {
            console.log(JSON.stringify(rows.map(({ object_key: _k, ...r }) => r), null, 2));
            return;
         }
         if (!rows.length) return console.log('no files');
         const kb = (n) => (Number(n) >= 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`);
         for (const r of rows)
            console.log(
               `${r.id} · ${r.filename} · ${r.content_type} · ${kb(r.size)} · ${r.created_at ? ist(r.created_at) + ' IST' : '–'} · ${r.from}`
            );
         return;
      }
      case 'file': {
         if (pos[0] !== 'get') die('usage: ops file get <file-id> [--out <path>]');
         const fid = need(pos[1], 'file id (from ops files)');
         let res;
         try {
            res = await fetch(`${BASE}/api/ops/attachments/${encodeURIComponent(fid)}`, {
               headers: { Authorization: `Bearer ${token()}` },
               redirect: 'manual',
            });
         } catch (e) {
            die(`cannot reach ${BASE} (${e.cause?.code || e.message})`);
         }
         if (!res.ok) die(`GET file ${fid} → ${res.status} ${(await res.text()).slice(0, 100)}`);
         const cd = res.headers.get('content-disposition') || '';
         const name = path.basename((cd.match(/filename="([^"]+)"/) || [])[1] || fid);
         const out = flags.out || name;
         if (fs.existsSync(out)) die(`${out} already exists; pass --out <path>`);
         const buf = Buffer.from(await res.arrayBuffer());
         fs.writeFileSync(out, buf);
         console.log(`saved ${out} (${buf.length} bytes, ${res.headers.get('content-type') || 'unknown type'})`);
         return;
      }
      case 'eod': {
         const id = need(pos[0], 'task id (OPS-n)');
         const body = readBody(need(flags.body, '--body <file|->')).trim();
         if (!body) die('EOD summary is empty');
         const { event } = await api('POST', `/issues/${encodeURIComponent(id)}/intern/events`, {
            kind: 'eod',
            body,
            at: atFlag(flags.at),
            by: session(),
         });
         console.log(`ok · ${ist(event.at)} IST · KB doc ${event.doc_id}`);
         return;
      }
      case 'review': {
         const id = need(pos[0], 'task id (OPS-n)');
         if (flags.fix) {
            if (flags.rating === undefined && flags.notes === undefined)
               die('ops review --fix needs --rating and/or --notes');
            const { event } = await api('PATCH', `/issues/${encodeURIComponent(id)}/intern/events`, {
               event_id: flags.event || null,
               rating: flags.rating === undefined ? null : Number(flags.rating),
               body: flags.notes,
               by: session(),
            });
            const was = event.original?.rating;
            console.log(
               `corrected review ${event.id} · rating ${was != null && was !== event.rating ? `${was} → ` : ''}${event.rating} · ${event.outcome}`
            );
            return;
         }
         const rating = Number(need(flags.rating, '--rating <1-5>'));
         const outcome = oneOf(
            need(flags.outcome, '--outcome <continue|changes|approve>'),
            ['continue', 'changes', 'approve'],
            'outcome'
         );
         const { event } = await api('POST', `/issues/${encodeURIComponent(id)}/intern/events`, {
            kind: 'review',
            rating,
            outcome,
            body: flags.notes || '',
            at: atFlag(flags.at),
            by: session(),
         });
         console.log(
            `ok · ${ist(event.at)} IST${outcome === 'approve' ? ` · ${id} approved and closed` : ''}`
         );
         return;
      }
      case undefined:
      case 'help':
      case '-h':
      case '--help':
         console.log(USAGE);
         return;
      default:
         die(`unknown command "${cmd}"\n\n${USAGE}`);
   }
}

main();
